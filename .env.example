# GEMINI_API_KEY: Optional. For Google Gemini AI models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional. For NVIDIA NIM models (build.nvidia.com / meta/llama-3.3-70b-instruct).
# You can use an NVIDIA API key (starts with nvapi-...) if you do not have a Gemini key.
NVIDIA_API_KEY="nvapi-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
