# GEMINI_API_KEY: Optional. For Google Gemini AI models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional. For NVIDIA NIM models (nvidia/llama-3.1-nemotron-70b-instruct, nvidia/nemotron-4-340b-instruct).
# You can use an NVIDIA API key (starts with nvapi-...) from build.nvidia.com.
NVIDIA_API_KEY="nvapi-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
